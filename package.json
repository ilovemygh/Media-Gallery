{
  "name": "media-gallery",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform visual media explorer, serverless device sync, unified music player, and YouTube downloader.",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "electron:build": "tsc -p tsconfig.electron.json",
    "dist:win": "npm run build && npm run electron:build && electron-builder --win nsis",
    "android:sync": "npm run build && npx cap sync android"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "ws": "^8.18.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
